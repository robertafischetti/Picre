        <property name="styleSheet">
         <string notr="true">/* ============================================================
   TREE WIDGET
   ============================================================ */

QTreeWidget {
    background-color: #252525;
    alternate-background-color: #2d2d2d;

    color: #e6e6e6;

    border: 1px solid #444444;
    border-radius: 3px;

    outline: none;

    show-decoration-selected: 1;
}


/* ============================================================
   TREE — ITEMS
   ============================================================ */

QTreeWidget::item {
    background-color: transparent;

    border: 1px solid transparent;

    padding: 5px 4px;
}


/* Hover */

QTreeWidget::item:hover {
    background-color: rgba(255, 193, 188, 51);
}


/* Selected */

QTreeWidget::item:selected {
	background-color: rgba(255, 193, 188, 51);
	
	color: rgba(255, 193, 188, 76);
    
    border: 1px solid white;
}


/* ============================================================
   TREE — BRANCHES
   ============================================================ */

/*
    We deliberately don't use the vline.png / branch images
    from the example stylesheet.

    Qt will therefore use its native branch indicators.
*/

QTreeWidget::branch {
    background-color: transparent;
}


/* ============================================================
   TREE — CHECKBOXES
   ============================================================ */

QTreeWidget::indicator {
    width: 14px;
    height: 14px;
}




/* ============================================================
   TREE — HEADER
   ============================================================ */

QHeaderView {
    background-color: #1e1e1e;
}


QHeaderView::section {
    background-color: #1e1e1e;

    color: #bbbbbb;

    padding: 6px 8px;

    border: none;
    border-right: 1px solid #3a3a3a;
    border-bottom: 1px solid #444444;

    font-weight: bold;
}


/* Header hover */

</string>
